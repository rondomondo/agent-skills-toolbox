{
  "action":                  { "type": "string",  "sensitive": false, "description": "Name of the currently running action" },
  "action_path":             { "type": "string",  "sensitive": false, "description": "Path of the action file" },
  "action_ref":              { "type": "string",  "sensitive": false, "description": "Ref of the action being used" },
  "action_repository":       { "type": "string",  "sensitive": false, "description": "owner/repo of the action" },
  "action_status":           { "type": "string",  "sensitive": false, "description": "Status of a composite action step" },
  "actor":                   { "type": "string",  "sensitive": false, "description": "Username that triggered the run" },
  "actor_id":                { "type": "string",  "sensitive": false, "description": "Account ID of the actor" },
  "api_url":                 { "type": "string",  "sensitive": false, "description": "GitHub REST API base URL" },
  "base_ref":                { "type": "string",  "sensitive": false, "description": "Base branch of a PR" },
  "env":                     { "type": "string",  "sensitive": false, "description": "Path to the env file on the runner" },
  "event":                   { "type": "object",  "sensitive": false, "description": "Full webhook event payload" },
  "event_name":              { "type": "string",  "sensitive": false, "description": "Event that triggered the run" },
  "event_path":              { "type": "string",  "sensitive": false, "description": "Path to the event payload file" },
  "graphql_url":             { "type": "string",  "sensitive": false, "description": "GitHub GraphQL API URL" },
  "head_ref":                { "type": "string",  "sensitive": false, "description": "Head branch of a PR" },
  "job":                     { "type": "string",  "sensitive": false, "description": "job_id of the current job" },
  "job_workflow_sha":        { "type": "string",  "sensitive": false, "description": "SHA of the reusable workflow file" },
  "output":                  { "type": "string",  "sensitive": false, "description": "Path to the step output file" },
  "path":                    { "type": "string",  "sensitive": false, "description": "Path to the PATH file on the runner" },
  "ref":                     { "type": "string",  "sensitive": false, "description": "Full ref that triggered the run, e.g. refs/heads/main" },
  "ref_name":                { "type": "string",  "sensitive": false, "description": "Short ref name, e.g. main or v1.2" },
  "ref_protected":           { "type": "boolean", "sensitive": false, "description": "Whether the ref is branch-protected" },
  "ref_type":                { "type": "string",  "sensitive": false, "description": "branch or tag" },
  "repository":              { "type": "string",  "sensitive": false, "description": "owner/repo" },
  "repository_id":           { "type": "string",  "sensitive": false, "description": "Numeric repository ID" },
  "repository_owner":        { "type": "string",  "sensitive": false, "description": "Owner of the repository" },
  "repository_owner_id":     { "type": "string",  "sensitive": false, "description": "Numeric owner ID" },
  "repositoryUrl":           { "type": "string",  "sensitive": false, "description": "Git URL of the repository" },
  "retention_days":          { "type": "string",  "sensitive": false, "description": "Artifact and log retention days" },
  "run_attempt":             { "type": "string",  "sensitive": false, "description": "Attempt number for this run (1-indexed)" },
  "run_id":                  { "type": "string",  "sensitive": false, "description": "Unique numeric ID for this workflow run" },
  "run_number":              { "type": "string",  "sensitive": false, "description": "Sequential run count for this workflow" },
  "secret_source":           { "type": "string",  "sensitive": false, "description": "Source of secrets: Actions, Codespaces, or Dependabot" },
  "server_url":              { "type": "string",  "sensitive": false, "description": "GitHub server URL, e.g. https://github.com" },
  "sha":                     { "type": "string",  "sensitive": false, "description": "Full commit SHA that triggered the run" },
  "step_summary":            { "type": "string",  "sensitive": false, "description": "Path to the step summary file" },
  "token":                   { "type": "string",  "sensitive": true,  "description": "Auto-generated GITHUB_TOKEN - always redact" },
  "triggering_actor":        { "type": "string",  "sensitive": false, "description": "Actor who re-triggered the run (may differ from actor)" },
  "workflow":                { "type": "string",  "sensitive": false, "description": "Name of the workflow" },
  "workflow_ref":            { "type": "string",  "sensitive": false, "description": "owner/repo/.github/workflows/file.yml@ref" },
  "workflow_sha":            { "type": "string",  "sensitive": false, "description": "SHA of the workflow file" },
  "workspace":               { "type": "string",  "sensitive": false, "description": "Default working directory path on the runner" }
}
