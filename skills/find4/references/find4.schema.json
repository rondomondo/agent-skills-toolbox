{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Find4Game",
    "type": "object",
    "required": ["metadata", "game_sets"],
    "additionalProperties": false,
    "properties": {
        "metadata": {
            "type": "object",
            "required": ["generated_at", "source", "suggested_name"],
            "additionalProperties": true,
            "properties": {
                "generated_at": { "type": "string", "format": "date-time" },
                "source": { "type": "string" },
                "suggested_name": { "type": "string", "pattern": "^[a-z0-9_-]+\\.json$" },
                "modified_at": { "type": "string", "format": "date-time" },
                "source_id": { "type": "string" },
                "step": { "type": "string" },
                "promoted": { "type": "boolean" },
                "id": { "type": "string" },
                "id_registry": { "$ref": "#/$defs/id_registry" }
            }
        },
        "game_sets": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/game_set" }
        },
        "id_registry": { "$ref": "#/$defs/id_registry" },
        "schema": { "$ref": "#/$defs/group_schema" }
    },
    "$defs": {
        "id_registry": {
            "type": "object",
            "properties": {
                "group_set_ids": { "type": "array", "items": { "type": "string" } },
                "game_set_ids": { "type": "array", "items": { "type": "string" } },
                "group_item_ids": { "type": "array", "items": { "type": "string" } }
            }
        },
        "game_set": {
            "type": "object",
            "required": ["theme", "group_sets"],
            "additionalProperties": false,
            "properties": {
                "theme": { "type": "string" },
                "game_set_id": { "type": "string" },
                "group_sets": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "array",
                        "minItems": 4,
                        "maxItems": 4,
                        "items": { "$ref": "#/$defs/group_item" }
                    }
                }
            }
        },
        "group_schema": {
            "type": "array",
            "items": { "type": "string" },
            "default": ["words", "category", "color", "url", "description", "skill_level", "additional_sources", "group_item_id", "group_set_id"]
        },
        "group_item": {
            "type": "object",
            "required": ["words", "category", "color", "description", "skill_level"],
            "additionalProperties": false,
            "properties": {
                "words": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "string" } },
                "category": { "type": "string" },
                "color": {
                    "type": "string",
                    "enum": ["red", "blue", "green", "yellow", "purple", "teal", "orange", "indigo"]
                },
                "url": { "type": "string", "format": "uri" },
                "description": { "type": "string" },
                "skill_level": { "type": "string", "enum": ["Beginner", "Intermediate", "Advanced", "Expert"] },
                "theme": { "type": "string" },
                "additional_sources": { "type": "array", "items": { "type": "string", "format": "uri" } },
                "group_item_id": { "type": "string" },
                "group_set_id": { "type": "string" }
            }
        }
    }
}
